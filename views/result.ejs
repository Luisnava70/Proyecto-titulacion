<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultado Final</title>
    <link rel="stylesheet" href="/styles/modules.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Roboto:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
</head>
<body>
    <div id="result" class="quizz-result">
        <% if(locals.message){ %>
            <h2><%= message %></h2>
        <% } %>
        <% if(locals.finalScore){ %>
            <p id="score">Puntaje Final: <%= finalScore %></p>
        <% } %>

        <% if(locals.questionAndAnswer) {%>
            <ul class="correct-answers">
                <% questionAndAnswer.forEach((question) => { %>
                    <li>
                        <%= question.question_text  %>
                        <%= question.answer_text %>
                    </li>
                <% }) %>
            </ul>
        <% } %>
        <button class="btnGoMainPage">
            <a href="/main-page">Menu Principal</a>
        </button>
    </div>
</body>
</html>