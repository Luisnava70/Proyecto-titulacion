<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevBurrito</title>
    <link rel="stylesheet" href="styles/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Roboto:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
</head>
<body>
    <main class="login-menu">
        <%- include("partials/logo.ejs") %>
        <h1>DevBurrito</h1>
        <% if (locals.incorrectPassword) {%>
            <p class="incorrect-password">Contraseña incorrecta</p>
        <% } else {%>
            <p class="login-text">Ingresa tu contraseña</p>
        <% } %>
        
        <form action="/set-password" method="POST">
            <div class="form-group">
                <input type="hidden" name="email" value="<%= email %>">
                <input type="password" class="<%= locals.incorrectPassword ? 'form-control incorrectPassword' : 'form-control' %>" name="password" placeholder="contraseña" required>
                <a href="/forgot-password" class="notice-to-user">olvidaste tu contraseña?</a>
                <button type="submit" class="btn btn-dark">Continuar</button>
            </div>
        </form>
    </main>
</body>
</html>