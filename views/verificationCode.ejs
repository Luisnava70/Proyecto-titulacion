<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevBurrito</title>
    <link rel="stylesheet" href="styles/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Roboto:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
</head>
<body>
    <main class="login-menu">
        <%- include("partials/logo.ejs") %>
        <h1>DevBurrito</h1>
        <% if(locals.verificationCode){ %>
            <p class="incorrect-password">Codigo incorrecto</p>
        <%} else{ %>
        <p class="login-text">Introduce el codigo de verificación</p>
        <% } %>
        <form action="/verification-code" method="POST">
            <div class="form-group">
                <input type="hidden" name="email" value="<%= email %>">
                <input type="text" class="<%= locals.verificationCode ? 'form-control incorrectPassword' : 'form-control' %>" name="codeVerification" placeholder="000000" required>
                <button type="submit" class="btn btn-dark">Restablecer contraseña</button>
            </div>
        </form>
    </main>
</body>
</html>